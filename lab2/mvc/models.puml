@startuml class-diagram
  class "User" as User {
    +email : string
    -password : string
    +first_name : ?string
    +last_name : ?string
    +__construct(email, password, first_name, last_name)
  }
  class "Users" as Users {
    +collection : 
    +users : ?array
    +__construct(users)
  }
  Users ..> User
@enduml
